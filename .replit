modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"
ignorePorts = false

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "publishing-health"

[[workflows.workflow]]
name = "publishing-health"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "env -u SMS_TEST_OVERRIDE_TO NODE_ENV=test RUN_BACKGROUND_JOBS=false SMS_LIVE=false pnpm --filter @workspace/api-server run test:publishing-health"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 23183
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SMS_LIVE = "false"
PUBLIC_API_URL = "https://retention-agent-ari205.replit.app"
REQUIRE_MARKETING_CONSENT = "false"
RETENTION_ONLY_MODE = "true"
VITE_NAV_MODE = "retention"
DEFAULT_CLUB_SLUG = "pb-club"

[userenv.development]
RUN_BACKGROUND_JOBS = "false"
